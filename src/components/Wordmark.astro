---
// Provolution wordmark. Inline SVG so the text picks up currentColor
// (light/dark) and the accent underline uses the CSS variable.
---
<svg
  class="wordmark"
  viewBox="0 0 400 50"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Provolution"
  preserveAspectRatio="xMinYMid meet"
>
  <text
    x="0"
    y="30"
    fill="currentColor"
    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    font-size="26"
    font-weight="700"
    letter-spacing="3.5"
  >PROVOLUTION</text>
  <line x1="0" y1="40" x2="60" y2="40" class="wordmark-accent" stroke-width="2.5" stroke-linecap="round"/>
</svg>
