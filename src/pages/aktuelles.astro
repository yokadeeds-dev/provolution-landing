---
import Base from '../layouts/Base.astro';

const entries = [
  {
    date: '27. Mai 2026',
    title: 'Website provolution.org live',
    body: 'Die wissenschaftliche Landing-Page ist online. Sechs Inhalts-Seiten (Framework, Methodik, Wissenschaft & Downloads, Über, Aktuelles, Startseite), drei konzeptionelle Diagramme (SEC-J, PS-Familie, Multi-Impact-Hexagon) sowie Impressum und Datenschutzerklärung. Methodisch konform mit WCAG 2.1 AA, ohne Cookies, ohne Tracking, ohne externe Schriftarten.',
  },
  {
    date: '27. Mai 2026',
    title: 'Wissenschaftliches Repository neu strukturiert',
    body: 'Das Provolution-Repository wurde für maximale wissenschaftliche Klarheit neu aufgebaut. Alle CANON-Dokumente, Daten und Methodik sind jetzt unter einer sauberen Struktur (canon/, manuscript/, applications/, studies/) zugänglich. Der vorherige Stand bleibt als Provolution-legacy privat erhalten — keine Inhalte gehen verloren, nur die Struktur ist klarer.',
    link: { href: 'https://github.com/yokadeeds-dev/Provolution', label: 'github.com/yokadeeds-dev/Provolution' },
  },
];
---
<Base title="Aktuelles" description="Aktuelle Mitteilungen und Versions-Updates zum Provolution-Framework.">
  <section class="hero">
    <div class="wrap">
      <div class="tag">Aktuelles</div>
      <h1>Aktuelles</h1>
      <p class="subtitle">Versions-Updates, Methodik-Anpassungen und Publikations-Meilensteine.</p>
    </div>
  </section>

  <div class="wrap">
    <h2 class="visually-hidden">Mitteilungen</h2>
    {entries.map(e => (
      <article class="entry" aria-labelledby={`entry-${e.date.replace(/\W+/g, '-')}-${e.title.slice(0, 20).replace(/\W+/g, '-')}`}>
        <span class="date">{e.date}</span>
        <h3 id={`entry-${e.date.replace(/\W+/g, '-')}-${e.title.slice(0, 20).replace(/\W+/g, '-')}`}>{e.title}</h3>
        <p>{e.body}</p>
        {e.link && <p><a href={e.link.href} rel="noopener" target="_blank">{e.link.label} &rarr;</a></p>}
      </article>
    ))}
  </div>
</Base>
